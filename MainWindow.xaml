<Window x:Class="FastDl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastDl" Width="920" Height="660" MinWidth="720" MinHeight="460"
        Background="#F3F3F3" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="OnPreviewDragOver" Drop="OnDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Botão de ícone (Segoe MDL2 Assets), usado nas linhas da lista -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D6D6D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão principal (azul) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2563EB" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Adicionar link -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="38" VerticalContentAlignment="Center" Padding="10,0" FontSize="14"
                     Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Cole o link do arquivo (ou arraste um link para esta janela)">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Height="38" Margin="10,0,0,0" Content="Baixar"
                    Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1" Margin="2,6,0,0" Foreground="#C62828" Text="{Binding ErrorText}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <!-- Configurações -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E1E1E1" BorderThickness="1"
                Padding="12" Margin="0,12,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Salvar em:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                             Text="{Binding DownloadFolder, UpdateSourceTrigger=LostFocus}"/>
                    <Button Grid.Column="2" Content="Escolher..." Style="{StaticResource TextButton}"
                            Command="{Binding BrowseFolderCommand}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Conexões por download:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="70" ItemsSource="{Binding ConnectionOptions}"
                              SelectedItem="{Binding ConnectionsPerDownload}"
                              ToolTip="Mais conexões = mais velocidade, se o servidor permitir"/>

                    <TextBlock Text="Downloads simultâneos:" Style="{StaticResource FieldLabel}" Margin="24,0,8,0"/>
                    <ComboBox Width="70" ItemsSource="{Binding SimultaneousOptions}"
                              SelectedItem="{Binding MaxSimultaneous}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lista de downloads -->
        <Grid Grid.Row="3">
            <TextBlock Text="Nenhum download ainda.&#x0A;Cole um link acima e clique em Baixar."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="#888888" FontSize="15"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" BorderBrush="#E1E1E1" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,8">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copiar link" Command="{Binding CopyUrlCommand}"/>
                                    <MenuItem Header="Abrir pasta" Command="{Binding OpenFolderCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Remover da lista" Command="{Binding RemoveCommand}"/>
                                    <MenuItem Header="Remover e apagar arquivos" Command="{Binding RemoveWithFilesCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>

                                    <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,6"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#666666"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ProgressBar Height="6" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding Indeterminate}"
                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#888888" Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Pausar"
                                            Command="{Binding PauseCommand}"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Retomar"
                                            Command="{Binding ResumeCommand}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Abrir arquivo"
                                            Command="{Binding OpenFileCommand}"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Abrir pasta"
                                            Command="{Binding OpenFolderCommand}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remover da lista"
                                            Command="{Binding RemoveCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Barra inferior -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#555555" Text="{Binding Summary}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Pausar todos" Style="{StaticResource TextButton}" Command="{Binding PauseAllCommand}"/>
                <Button Content="Retomar todos" Style="{StaticResource TextButton}" Command="{Binding ResumeAllCommand}"/>
                <Button Content="Limpar concluídos" Style="{StaticResource TextButton}" Command="{Binding ClearCompletedCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
